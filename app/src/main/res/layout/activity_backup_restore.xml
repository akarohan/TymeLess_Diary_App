<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    tools:context=".BackupRestoreActivity">

    <!-- Modern Header -->
    <LinearLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="?android:textColorPrimary" />

        <!-- Title -->
        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Backup And Restore"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Spacer to balance the back button -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Backup Icon -->
    <ImageView
        android:id="@+id/backup_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_backup"
        android:background="@drawable/circle_background"
        android:padding="16dp"
        android:tint="?android:textColorPrimary"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Backup Information -->
    <TextView
        android:id="@+id/text_last_backup_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Backup:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/backup_icon"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/text_last_backup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textSize="16sp"
        android:textColor="@color/text"
        app:layout_constraintTop_toTopOf="@id/text_last_backup_label"
        app:layout_constraintStart_toEndOf="@id/text_last_backup_label"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/text_backup_path_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Backup Folder:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_last_backup_label"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/text_backup_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="--"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/text_backup_path_label"
        app:layout_constraintStart_toEndOf="@id/text_backup_path_label"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp" />

    <!-- Backup Options Section -->
    <TextView
        android:id="@+id/text_backup_options_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What do you want to Backup?"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_backup_path"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp" />

    <!-- Images Option -->
    <TextView
        android:id="@+id/text_images"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Images"
        android:textSize="16sp"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_backup_options_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_images"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/text_images"
        app:layout_constraintBottom_toBottomOf="@id/text_images"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp" />

    <!-- Audio Option -->
    <TextView
        android:id="@+id/text_audio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Audio"
        android:textSize="16sp"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_images"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_audio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/text_audio"
        app:layout_constraintBottom_toBottomOf="@id/text_audio"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp" />

    <!-- Diary Option -->
    <TextView
        android:id="@+id/text_diary_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diary"
        android:textSize="16sp"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_audio"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_diary_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/text_diary_notes"
        app:layout_constraintBottom_toBottomOf="@id/text_diary_notes"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp" />

    <!-- Notes Option -->
    <TextView
        android:id="@+id/text_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes"
        android:textSize="16sp"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_diary_notes"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/text_notes"
        app:layout_constraintBottom_toBottomOf="@id/text_notes"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp" />

    <!-- Profile Settings Option -->
    <TextView
        android:id="@+id/text_profile_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Settings"
        android:textSize="16sp"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/text_notes"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_profile_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/text_profile_settings"
        app:layout_constraintBottom_toBottomOf="@id/text_profile_settings"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp" />

    <!-- Progress and Status -->
    <TextView
        android:id="@+id/text_backup_complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Backup Complete"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/switch_profile_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/text_restore_complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restore Complete"
        android:textSize="16sp"
        android:textColor="@android:color/holo_green_dark"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/switch_profile_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <ProgressBar
        android:id="@+id/progress_backup"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/progress_bar_green"
        android:visibility="gone"
        android:max="100"
        app:layout_constraintTop_toBottomOf="@id/text_profile_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/button_restore" />

    <!-- Action Buttons -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_restore"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/button_bg"
        android:textColor="@color/button_text"
        android:text="Restore"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/button_choose_folder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_choose_folder"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Choose Backup Folder"
        android:textSize="16sp"
        android:textColor="@color/button_text"
        android:backgroundTint="@color/button_bg"
        app:layout_constraintBottom_toTopOf="@id/button_backup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_backup"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Backup"
        android:textSize="16sp"
        android:textColor="@color/button_text"
        android:backgroundTint="@color/button_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout> 