<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp">

    <!-- Theme Picture Background -->
    <ImageView
        android:id="@+id/themeBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_icemountain_optimized"/>

    <!-- Profile Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Profile Picture -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/navProfileImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_user_placeholder"
                app:civ_border_color="?android:textColorPrimary"
                app:civ_border_width="2dp" />

        </FrameLayout>

        <!-- User Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:maxWidth="180dp"
            android:minWidth="120dp">

            <!-- First Name -->
            <TextView
                android:id="@+id/navUserFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rohan"
                android:textSize="22sp"
                android:textColor="?android:textColorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:includeFontPadding="false"/>

            <!-- Last Name -->
            <TextView
                android:id="@+id/navUserLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mahapatra"
                android:textSize="22sp"
                android:textColor="?android:textColorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:includeFontPadding="false"/>

            <!-- Username -->
            <TextView
                android:id="@+id/navUserUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@rohan"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:includeFontPadding="false"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout> 