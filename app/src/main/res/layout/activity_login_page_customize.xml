<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:windowBackground">

    <!-- Modern Header -->
    <LinearLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="?android:textColorPrimary" />

        <!-- Title -->
        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Customise Login Page"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Spacer to balance the back button -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Current Background Section -->
        <LinearLayout
            android:id="@+id/currentBackgroundContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Login Background"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="250dp"
                android:layout_height="400dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <VideoView
                android:id="@+id/previewVideo"
                android:layout_width="250dp"
                android:layout_height="400dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Default Background Message -->
        <TextView
            android:id="@+id/defaultBackgroundMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No custom login background set.\nDefault purple background will be used."
            android:textSize="16sp"
            android:textColor="?android:textColorSecondary"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/pickMediaButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick Image or Video"
                android:textColor="?android:textColorPrimary"
                android:backgroundTint="?android:colorBackground" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save as Login Background"
                android:textColor="?android:textColorPrimary"
                android:backgroundTint="?android:colorBackground"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/removeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remove Current Background"
                android:textColor="?android:textColorPrimary"
                android:backgroundTint="?android:colorBackground"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout> 