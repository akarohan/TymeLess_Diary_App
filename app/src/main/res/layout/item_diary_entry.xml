<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="11dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/card_light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Masonry Images Row -->
        <LinearLayout
            android:id="@+id/imagesRow"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <!-- Left: Large image -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">
                
                                        <ImageView
                            android:id="@+id/imageLeft"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:contentDescription="Entry image 1"/>
            </androidx.cardview.widget.CardView>

            <!-- Right: Two stacked images -->
            <LinearLayout
                android:id="@+id/rightColumn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="1dp"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    
                    <ImageView
                        android:id="@+id/imageTopRight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:contentDescription="Entry image 2"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/bottomRightRow"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="1dp"
                    android:orientation="horizontal">
                    
                    <androidx.cardview.widget.CardView
                        android:id="@+id/bottomRightContainer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="1dp"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        
                        <ImageView
                            android:id="@+id/imageBottomRight"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:contentDescription="Entry image 3"/>
                    </androidx.cardview.widget.CardView>
                    
                    <androidx.cardview.widget.CardView
                        android:id="@+id/bottomRightContainer2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="1dp"
                        android:visibility="gone"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        
                        <ImageView
                            android:id="@+id/imageBottomRight2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:contentDescription="Entry image 4"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>



        <!-- Title -->
        <TextView
            android:id="@+id/entryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/card_title_color"
            android:layout_marginTop="4dp"/>



        <!-- Main Text -->
        <TextView
            android:id="@+id/entryPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/card_preview_color"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:singleLine="false"/>

        <!-- Bottom Row: Date pill, mood emoji, and actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:baselineAligned="false">

            <!-- Left side elements -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Date pill -->
                <TextView
                    android:id="@+id/entryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_date_pill"
                    android:textColor="@color/edit_hint_color"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="9sp"
                    android:text="Thu, Sep 20"/>

                <!-- Location chip -->
                <LinearLayout
                    android:id="@+id/locationChipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_location_pill"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/locationChipIcon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_location_on"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Location icon"/>

                    <TextView
                        android:id="@+id/locationChipText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chip_text_color"
                        android:textSize="9sp"
                        android:text="Location"/>

                </LinearLayout>


                <!-- Audio indicator -->
                <ImageView
                    android:id="@+id/audioIndicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_mic_filled"
                    android:layout_marginStart="5dp"
                    android:visibility="gone"
                    android:contentDescription="Audio indicator"/>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Action icons (optional) -->
            <ImageView
                android:id="@+id/deleteButton"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:src="@drawable/ic_dustbin_clean"
                android:contentDescription="Delete entry"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView> 