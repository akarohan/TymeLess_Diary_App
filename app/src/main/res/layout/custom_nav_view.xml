<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_nav_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:windowBackground">

    <!-- Custom Header -->
    <include layout="@layout/nav_header_main" />

    <!-- Menu Items -->
    <LinearLayout
        android:id="@+id/nav_menu_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="?android:windowBackground">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>

        <!-- Account Settings -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_settings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Settings"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>

        <!-- Customise Login Page -->
        <LinearLayout
            android:id="@+id/nav_customize_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_customize_login_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pen_black"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_customize_login_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customise Login Page"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>



        <!-- Change Theme Picture -->
        <LinearLayout
            android:id="@+id/nav_change_theme_pic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_change_theme_pic_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu_camera"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_change_theme_pic_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change Theme Picture"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>

        <!-- Backup And Restore -->
        <LinearLayout
            android:id="@+id/nav_backup_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_backup_restore_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_backup"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_backup_restore_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backup And Restore"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>

        <!-- Recycle Bin -->
        <LinearLayout
            android:id="@+id/nav_recycle_bin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_recycle_bin_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dustbin_clean"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_recycle_bin_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recycle Bin"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>

        <!-- Log Out -->
        <LinearLayout
            android:id="@+id/nav_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_logout_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logout_black"
                android:layout_marginEnd="16dp"
                android:tint="?android:textColorPrimary"/>

            <TextView
                android:id="@+id/nav_logout_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/nav_footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:background="?android:windowBackground">

        <TextView
            android:id="@+id/navAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 3.6.12"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/navBuiltBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Built By Rohan"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"/>

    </LinearLayout>

</LinearLayout> 