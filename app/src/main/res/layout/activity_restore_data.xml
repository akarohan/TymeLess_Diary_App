<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fff"
    android:gravity="center_horizontal">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/restore_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Restore"
            android:textColor="#fff"
            android:textStyle="bold"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Backup Icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_backup"
        android:contentDescription="Backup Icon" />

    <!-- Backup Found Text -->
    <TextView
        android:id="@+id/backup_found"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Backup Found !!!"
        android:textSize="28sp"
        android:textColor="#000"
        android:fontFamily="@font/vegur_bold"
        android:layout_marginTop="24dp" />

    <!-- Details (left-aligned, no 'Backup found:' or 'Will restore') -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <TextView
            android:id="@+id/backup_entries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diary Entries: 6"
            android:textSize="16sp"
            android:textColor="#000"
            android:fontFamily="@font/vegur_bold"
            android:gravity="start" />
        <TextView
            android:id="@+id/backup_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes: 7"
            android:textSize="16sp"
            android:textColor="#000"
            android:fontFamily="@font/vegur_bold"
            android:gravity="start" />
        <TextView
            android:id="@+id/backup_others"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Others: Theme Pic, Theme Color, Profile Pic, Cover Pic"
            android:textSize="16sp"
            android:textColor="#000"
            android:fontFamily="@font/vegur_bold"
            android:gravity="start"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Spacer to push bottom section down -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Section: Prompt, Warning, Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Restore Prompt -->
        <TextView
            android:id="@+id/restore_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Would You Like to\nRestore this Backup?"
            android:textSize="22sp"
            android:textColor="#000"
            android:fontFamily="@font/vegur_bold"
            android:textStyle="bold"
            android:layout_marginTop="0dp"
            android:gravity="center" />

        <!-- Warning -->
        <TextView
            android:id="@+id/restore_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(If Skipped, The backup will be deleted forever)"
            android:textSize="13sp"
            android:textColor="#444"
            android:fontFamily="@font/vegur_bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:gravity="center" />

        <!-- Restore Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_restore"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="RESTORE"
            android:textAllCaps="true"
            android:textSize="26sp"
            android:textColor="#fff"
            android:fontFamily="@font/vegur_bold"
            android:background="@drawable/black_button_background"
            android:backgroundTint="#000000"
            android:stateListAnimator="@null"
            android:elevation="8dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="14dp" />

        <!-- Skip Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_skip"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="SKIP"
            android:textAllCaps="true"
            android:textSize="20sp"
            android:textColor="#fff"
            android:fontFamily="@font/vegur_bold"
            android:background="@drawable/black_button_background"
            android:backgroundTint="#000000"
            android:stateListAnimator="@null"
            android:elevation="8dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>

</LinearLayout> 