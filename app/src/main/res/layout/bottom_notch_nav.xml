<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/notch_nav_bg"
    android:padding="2dp"
    android:elevation="2dp">

    <!-- Diary Tab -->
    <LinearLayout
        android:id="@+id/diaryTab"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:background="@drawable/notch_nav_tab_left_selector"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/diaryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_diary"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/diaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

    </LinearLayout>

    <!-- Notes Tab -->
    <LinearLayout
        android:id="@+id/notesTab"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:background="@drawable/notch_nav_tab_right_selector"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/notesIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notes"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/notesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

    </LinearLayout>

</LinearLayout> 