<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/skyblue_note_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="11dp">

        <!-- Image on top, landscape, curved edges -->
        <androidx.cardview.widget.CardView
            android:id="@+id/anoteImageContainer"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/anoteImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:contentDescription="A note image"/>
        </androidx.cardview.widget.CardView>

        <!-- Title with lock icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/anoteTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Title Here"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black"/>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_lock_lock"
                android:contentDescription="Password protected"
                android:tint="@color/black"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/anoteContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main text"
                                          android:textSize="11sp"
              android:textColor="@color/black"
              android:layout_marginTop="6dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <ImageView
                android:id="@+id/btnDeleteANote"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="end|bottom"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:src="@drawable/ic_dustbin_clean"
                android:contentDescription="Delete note"
                android:padding="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="0dp"
                android:clickable="true"
                android:focusable="true"/>
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 