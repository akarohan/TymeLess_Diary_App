<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground">

    <!-- Modern Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="?android:textColorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Title - Perfectly centered -->
        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diary Entry"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Edit Button -->
        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pen_black"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Edit"
            android:tint="?android:textColorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Date and Time -->
            <TextView
                android:id="@+id/entryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26 JANUARY"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Current Location Display - Right side of date -->
            <LinearLayout
                android:id="@+id/currentLocationContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_health_data"
                android:padding="6dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:selectableItemBackground"
                android:maxWidth="120dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location_on"
                    android:tint="#FF6B35"
                    android:layout_marginEnd="3dp"/>

                <TextView
                    android:id="@+id/currentLocationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </LinearLayout>

            <TextView
                android:id="@+id/entryYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025, Sunday"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                app:layout_constraintTop_toBottomOf="@id/entryDate"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/entryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="New Year New Life"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/entryYear"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Health Data Section - Labels on Top, Values Below -->
            <LinearLayout
                android:id="@+id/healthDataSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_health_data"
                android:padding="12dp"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/entryTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Steps -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="4dp">
                        
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_running_shoe"
                            android:tint="#39FF14"
                            android:layout_marginEnd="4dp"/>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Steps"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#39FF14"
                            android:gravity="center"/>
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/stepsData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Data"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#39FF14"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Sleep -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="4dp">
                        
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bed"
                            android:tint="#FF1493"
                            android:layout_marginEnd="4dp"/>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sleep"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FF1493"
                            android:gravity="center"/>
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/sleepData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Data"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FF1493"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Screen Time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="16dp">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="4dp">
                        
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_screen_time"
                            android:tint="#00FFFF"
                            android:layout_marginEnd="4dp"/>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Screen"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#00FFFF"
                            android:gravity="center"/>
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/screenTimeData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Data"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#00FFFF"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>





            <!-- Horizontal Image Gallery -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/imageGallery"
                android:layout_width="0dp"
                android:layout_height="250dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/healthDataSection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Image Indicator Dots -->
            <LinearLayout
                android:id="@+id/imageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/imageGallery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Content -->
            <TextView
                android:id="@+id/entryContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Been several months since I last wrote. And there are sometimes I'm glad about... Some not so much."
                android:textSize="16sp"
                android:textColor="@color/text"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/imageIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout> 