<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="80dp"
    android:minWidth="120dp"
    android:background="@drawable/bg_audio_chip_pill"
    android:layout_margin="8dp"
    android:elevation="8dp"
    android:translationZ="4dp">

    <!-- Delete button at top right -->
    <ImageButton
        android:id="@+id/audioDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_circle_cross"
        android:contentDescription="Delete audio"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:focusable="false"
        android:clickable="true"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Play/Pause mic icon -->
        <ImageButton
            android:id="@+id/audioIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_white_bg"
            android:src="@drawable/ic_mic_filled"
            android:contentDescription="Play or pause audio"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginEnd="8dp"/>

        <!-- Vertical stack: waveform and duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Waveform at the top, much larger -->
            <ImageView
                android:id="@+id/audioWaveform"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_waveform" />

            <!-- Duration at the bottom, smaller -->
            <TextView
                android:id="@+id/audioDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:15"
                android:textColor="#222222"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout> 